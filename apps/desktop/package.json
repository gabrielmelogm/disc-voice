{
  "name": "@disc-voice/desktop",
  "version": "0.1.0-alpha.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri:dev": "node scripts/native-platform.mjs && tauri dev",
    "tauri:build": "node scripts/native-platform.mjs win32 && tauri build --bundles nsis",
    "tauri:build:linux": "node scripts/native-platform.mjs linux && tauri build --bundles deb,rpm",
    "tauri:build:appimage": "node scripts/native-platform.mjs linux && tauri build --bundles appimage",
    "tauri:build:linux:all": "node scripts/native-platform.mjs linux && tauri build --bundles appimage,deb,rpm"
  },
  "dependencies": {
    "@disc-voice/shared": "*",
    "@fabianlars/tauri-plugin-oauth": "^2.1.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
