# Configuração local. Copie para .env na raiz.
# O banco é iniciado com `npm run db:up` (ou `npm run services:up`).
POSTGRES_PASSWORD=discvoice_local
POSTGRES_PORT=5433
# Mantenha a porta e a senha iguais às variáveis POSTGRES_* acima.
DATABASE_URL=postgres://discvoice:discvoice_local@127.0.0.1:5433/discvoice
API_BIND=127.0.0.1:3001
PUBLIC_WEB_URL=http://localhost:3001
# A API serve também a versão web compilada.
WEB_DIST=apps/desktop/dist
# CORS_ORIGINS substitui a lista padrão quando definido.
# CORS_ORIGINS=https://seu-dominio.com,https://tauri.localhost,http://tauri.localhost,tauri://localhost
# Definida no build do frontend; deixe vazia no desenvolvimento local.
# No desktop distribuído, use a URL HTTPS pública da API com /api.
VITE_API_URL=
