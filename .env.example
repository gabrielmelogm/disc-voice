# Configuração local. Copie para .env na raiz.
# O banco é iniciado com `npm run db:up` (ou `npm run services:up`).
POSTGRES_PASSWORD=discvoice_local
POSTGRES_PORT=5433
# Mantenha a porta e a senha iguais às variáveis POSTGRES_* acima.
DATABASE_URL=postgres://discvoice:discvoice_local@127.0.0.1:5433/discvoice
API_BIND=127.0.0.1:3001
PUBLIC_WEB_URL=http://localhost:3001
# A API serve também a versão web compilada.
WEB_DIST=apps/desktop/dist
# CORS_ORIGINS substitui as origens extras padrão (dev e Tauri) quando definido.
# PUBLIC_WEB_URL é sempre aceita, inclusive no WebSocket /api/realtime.
# CORS_ORIGINS=https://seu-dominio.com,https://tauri.localhost,http://tauri.localhost,tauri://localhost
# Definida no build do frontend; deixe vazia no desenvolvimento local.
# No desktop distribuído, use a URL HTTPS pública da API com /api.
VITE_API_URL=

# Login com Google (único método de login). Crie dois clientes OAuth no
# Google Cloud Console (Google Auth Platform > Clients); veja DOCS.md.
# Cliente do tipo "App para computador" (desktop, redirecionamento loopback).
GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_SECRET=
# Cliente do tipo "Aplicativo da Web", com redirecionamento
# <origem>/auth/google/callback (ex.: http://localhost:1420/auth/google/callback).
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=

# Voz WebRTC ponto a ponto. Limite por canal (2 a 32, padrão 8).
VOICE_CHANNEL_CAPACITY=8
STUN_URL=stun:stun.l.google.com:19302
# TURN permite áudio entre redes que bloqueiam conexões diretas.
# Preencha e inicie com: docker compose --profile voice up --build -d
# TURN_URLS=turn:voz.exemplo.com:3478?transport=udp,turn:voz.exemplo.com:3478?transport=tcp
TURN_URLS=
# Segredo compartilhado somente entre API e Coturn; use um valor aleatório longo.
TURN_SECRET=
# IP público do host Coturn; publique também as portas UDP de relay.
TURN_EXTERNAL_IP=127.0.0.1
