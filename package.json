{
  "name": "disc-voice",
  "version": "0.1.0-alpha.3",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev:api": "npm run db:up && cargo run -p disc-api",
    "db:up": "docker compose up -d --wait db",
    "dev:user": "node scripts/dev-user.mjs",
    "services:up": "docker compose up --build -d",
    "services:down": "docker compose down",
    "dev": "npm run tauri:dev --workspace @disc-voice/desktop",
    "dev:web": "npm run dev --workspace @disc-voice/desktop",
    "dev:site": "npm run dev --workspace @disc-voice/website",
    "build:site": "npm run build --workspace @disc-voice/website",
    "build": "npm run build --workspace @disc-voice/desktop",
    "build:windows": "npm run tauri:build --workspace @disc-voice/desktop",
    "build:linux": "npm run tauri:build:linux --workspace @disc-voice/desktop",
    "build:appimage": "npm run tauri:build:appimage --workspace @disc-voice/desktop",
    "build:linux:all": "npm run tauri:build:linux:all --workspace @disc-voice/desktop",
    "typecheck": "npm run typecheck --workspace @disc-voice/desktop",
    "test": "npm run test --workspace @disc-voice/desktop",
    "test:rust": "cargo test --workspace",
    "test:api": "cargo test -p disc-api --test api -- --ignored --test-threads=1",
    "test:audio": "cargo test -p disc-audio",
    "check": "npm run typecheck && npm test && npm run build"
  }
}
